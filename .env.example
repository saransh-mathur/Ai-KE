# ==============================================================================
# Enterprise IT Asset & Vendor Semantic Knowledge Engine
# Environment Configuration Template (.env.example)
# ==============================================================================

# AI Studio injected environment variables (Option 1: Google Gemini API)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Option 2: Any Online OpenAI-Compatible AI Provider (OpenAI, Groq, OpenRouter, Together, DeepSeek, etc.)
# CUSTOM_AI_API_KEY="sk-your-online-api-key"
# CUSTOM_AI_BASE_URL="https://api.openai.com/v1"
# CUSTOM_AI_MODEL="gpt-4o-mini"

# Option 3: Local LLM via Ollama (100% Offline, Free & Private)
# OLLAMA_HOST="http://localhost:11434"

# PostgreSQL / Cloud SQL Connection (Object Method)
# Quick local setup: copy repo, then run `npm run db:setup` (auto-configures Docker pgvector or local Postgres).
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your-strong-db-password"
SQL_DB_NAME="ai_knowledge_engine"
# Optional SSL for hosted Postgres (Neon, Supabase, RDS): "true" | "false"
# SQL_SSL="false"
# Optional elevated admin credentials for drizzle-kit migrations (defaults to SQL_USER/SQL_PASSWORD)
# SQL_ADMIN_USER="postgres"
# SQL_ADMIN_PASSWORD="your-strong-db-password"

# (Optional) Firebase & Google SSO Environment Overrides
# Use these if you prefer environment variables over firebase-applet-config.json.
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# VITE_FIREBASE_APP_ID="1:...:web:..."
